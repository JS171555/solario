# Supabase é opcional: sem estas variáveis o jogo roda em modo local
# (o progresso fica no localStorage do aparelho).
#
# A chave "anon" é pública por design. A proteção dos dados vem das
# políticas de RLS definidas em supabase/schema.sql.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
